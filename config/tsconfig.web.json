{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "../src/renderer/src/env.d.ts",
    "../src/renderer/src/**/*",
    "../src/renderer/src/**/*.tsx",
    "../src/preload/api-types.ts",
    "../src/preload/api/**/*",
    "../src/shared/**/*"
  ],
  "exclude": [
    "../**/node_modules/**",
    "../**/* 1.ts",
    "../**/* 1.tsx",
    "../**/* 2.ts",
    "../**/* 2.tsx",
    "../**/* 3.ts",
    "../**/* 3.tsx",
    "../**/* 4.ts",
    "../**/* 4.tsx",
    "../**/* 5.ts",
    "../**/* 5.tsx",
    "../**/* 6.ts",
    "../**/* 6.tsx",
    "../**/* 7.ts",
    "../**/* 7.tsx",
    "../**/* 8.ts",
    "../**/* 8.tsx",
    "../**/* 9.ts",
    "../**/* 9.tsx"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "paths": {
      "@renderer/*": ["../src/renderer/src/*"],
      "@/*": ["../src/renderer/src/*"]
    }
  }
}
