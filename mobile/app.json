{
  "expo": {
    "name": "Forflow One",
    "slug": "forflow-one-mobile",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/forflow-app-icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "forflow-one-mobile",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/forflow-app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#111111"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cn.forflow.one.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Forflow One 通过局域网连接你配对的桌面端。",
        "NSMicrophoneUsageDescription": "允许 Forflow One 录音，并交给已配对的桌面端转写。",
        "NSPhotoLibraryUsageDescription": "允许 Forflow One 将你选择的照片发送到已配对的桌面会话。",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "100.64.0.0/10": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            },
            "fd7a:115c:a1e0::/48": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        },
        "ITSAppUsesNonExemptEncryption": false,
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/forflow-mark.png",
        "backgroundColor": "#111111"
      },
      "usesCleartextTraffic": true,
      "allowBackup": false,
      "permissions": ["RECORD_AUDIO", "MODIFY_AUDIO_SETTINGS"],
      "package": "cn.forflow.one.mobile",
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "./plugins/android-respect-rotation-lock.js",
      [
        "expo-splash-screen",
        {
          "image": "./assets/forflow-app-icon.png",
          "backgroundColor": "#111111"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "允许 Forflow One 使用相机扫描桌面配对码。",
          "microphonePermission": "允许 Forflow One 录音，并交给已配对的桌面端转写。",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允许 Forflow One 将你选择的照片发送到已配对的桌面会话。"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          },
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
